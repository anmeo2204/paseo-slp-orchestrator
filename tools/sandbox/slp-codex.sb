;; Seatbelt policy for SLP Codex agents (prototype, see docs/audits/PHASE1_SEATBELT_FEASIBILITY.md).
;; Applied by tools/sandbox/slp-codex-sandbox to `codex app-server` and inherited by every child process.
;; All paths must be real paths (no symlinks): Seatbelt matches the resolved path, e.g. /private/var/... for /var/...
;;
;; Parameters (all required, passed with sandbox-exec -D):
;;   HOME_DIR           the user's home directory
;;   BUS_PORT           the SLP MCP bus port on 127.0.0.1
;;   SLP_STATE_DIR      ~/.slp-orchestrator
;;   PASEO_HOME         ~/.paseo
;;   PASEO_WORKTREES    ~/.paseo/worktrees
;;   PASEO_WORKTREES_RE PASEO_WORKTREES with regex metacharacters escaped
;;   PASEO_APP_SUPPORT  ~/Library/Application Support/Paseo
;;   PLUGIN_SOURCE_DIR  the SLP plugin checkout
;;   CODEX_HOME_DIR     the dedicated SLP Codex home (not the Manager's ~/.codex)
;;   CODEX_HOME_RE      CODEX_HOME_DIR with regex metacharacters escaped
;;   GIT_REPOS_RE       escaped main-repository paths SLP runs on, joined with `|` (from $SLP_SANDBOX_REPOS)
;;   MANAGER_CODEX_HOME the Manager's ~/.codex
;;   TMP_DIR            a private per-session temp dir created by the wrapper (exported to Codex as $TMPDIR)
;;   CACHE_DIR          the per-user cache dir (getconf DARWIN_USER_CACHE_DIR), used by compilers

(version 1)
(allow default)

;; ---------------------------------------------------------------------------
;; R2 / R3 — SLP state, Paseo state and credentials: no read, no write.
;; ---------------------------------------------------------------------------
(deny file-read* file-write*
  (subpath (param "SLP_STATE_DIR"))
  (subpath (param "PASEO_HOME"))
  (subpath (param "PASEO_APP_SUPPORT"))
  (subpath (param "MANAGER_CODEX_HOME")))

;; Defence in depth for other credentials an agent has no use for. Reads elsewhere in the home directory stay
;; allowed because development tools need them; this list is not exhaustive (see the feasibility report, §6).
(deny file-read* file-write*
  (subpath (string-append (param "HOME_DIR") "/.ssh"))
  (subpath (string-append (param "HOME_DIR") "/.gnupg"))
  (subpath (string-append (param "HOME_DIR") "/.aws"))
  (subpath (string-append (param "HOME_DIR") "/.azure"))
  (subpath (string-append (param "HOME_DIR") "/.kube"))
  (subpath (string-append (param "HOME_DIR") "/.config/gcloud"))
  (subpath (string-append (param "HOME_DIR") "/.config/gh"))
  (subpath (string-append (param "HOME_DIR") "/.docker"))
  (literal (string-append (param "HOME_DIR") "/.netrc"))
  (literal (string-append (param "HOME_DIR") "/.git-credentials"))
  (subpath (string-append (param "HOME_DIR") "/.cursor"))
  (subpath (string-append (param "HOME_DIR") "/Library/Keychains"))
  (subpath (string-append (param "HOME_DIR") "/Library/Cookies"))
  (subpath (string-append (param "HOME_DIR") "/Library/Application Support/Google/Chrome"))
  (subpath (string-append (param "HOME_DIR") "/Library/Application Support/Cursor"))
  (subpath (string-append (param "HOME_DIR") "/Library/Application Support/Code")))

;; Agent worktrees live under ~/.paseo/worktrees and are the only part of ~/.paseo an agent may use.
(allow file-read* (subpath (param "PASEO_WORKTREES")))
;; The standalone Codex install keeps its binaries in ~/.codex/packages; they stay readable (never writable) so the
;; sandboxed app-server can execute. Config, auth, sessions and IPC sockets in ~/.codex remain denied.
(allow file-read* (subpath (string-append (param "MANAGER_CODEX_HOME") "/packages")))

;; ---------------------------------------------------------------------------
;; Writes are denied by default and re-allowed only where agents legitimately work.
;; This also blocks persistence outside the sandbox: shell rc files, LaunchAgents, git hooks, Codex config.
;; ---------------------------------------------------------------------------
(deny file-write*)

(allow file-write*
  (subpath (param "PASEO_WORKTREES"))
  (subpath (param "TMP_DIR"))
  (subpath "/private/tmp")
  (subpath (param "CACHE_DIR"))
  (subpath (string-append (param "HOME_DIR") "/.npm"))
  (subpath (string-append (param "HOME_DIR") "/.cache"))
  (subpath (string-append (param "HOME_DIR") "/Library/Caches"))
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/tty") (literal "/dev/dtracehelper")
  (regex #"^/dev/(fd/[0-9]+|ttys[0-9]+|ptmx|ttyp[0-9a-f]+)$"))

;; A worktree's `.git` is a pointer file. Rewriting it would make the plugin's own (unsandboxed) git commands run
;; against an attacker-built git dir with hooks, so the pointer stays read-only.
(deny file-write* (regex (string-append "^" (param "PASEO_WORKTREES_RE") "/[^/]+/[^/]+/\\.git$")))

;; Commits from a worktree write objects and refs into the main repository's .git. Only git's data files, and only
;; in the repositories the Manager listed, are writable there; hooks, config, info/ and per-worktree config stay
;; read-only because the plugin runs git unsandboxed. Other repositories on disk keep read-only refs and objects.
(allow file-write*
  (regex (string-append "^(" (param "GIT_REPOS_RE") ")/\\.git/(objects|refs|logs)/"))
  (regex (string-append "^(" (param "GIT_REPOS_RE") ")/\\.git/(packed-refs|packed-refs\\.lock)$"))
  (regex (string-append "^(" (param "GIT_REPOS_RE") ")/\\.git/worktrees/[^/]+/(HEAD|ORIG_HEAD|FETCH_HEAD|MERGE_HEAD|MERGE_MSG|AUTO_MERGE|COMMIT_EDITMSG|index|logs/.*)(\\.lock)?$")))
(deny file-write*
  (regex #"/\.git/hooks(/|$)")
  (regex #"/\.git/(config|config\.worktree)(\.lock)?$")
  (regex #"/\.git/worktrees/[^/]+/config\.worktree(\.lock)?$")
  (regex #"/\.git/info(/|$)"))

;; Dedicated Codex home: sessions, logs, state and token refresh are writable; configuration is not, so an agent
;; cannot register an MCP server or change sandbox settings for later sessions.
(allow file-write* (subpath (param "CODEX_HOME_DIR")))
(deny file-write*
  (regex (string-append "^" (param "CODEX_HOME_RE") "/.*\\.toml$"))
  (literal (string-append (param "CODEX_HOME_DIR") "/AGENTS.md"))
  (subpath (string-append (param "CODEX_HOME_DIR") "/rules"))
  (subpath (string-append (param "CODEX_HOME_DIR") "/skills"))
  (subpath (string-append (param "CODEX_HOME_DIR") "/plugins")))

;; The plugin source must never change from inside an agent, whatever rule above might match it.
(deny file-write* (subpath (param "PLUGIN_SOURCE_DIR")))

;; ---------------------------------------------------------------------------
;; R1 — network. Loopback is denied as a whole (daemon WebSocket, Paseo Agent MCP, any other local service),
;; then re-opened only for the SLP bus and a fixed connect-only pool below the macOS ephemeral range (49152+), for
;; services the Manager starts outside the sandbox (e.g. a test database); a daemon or bus port chosen by the OS can
;; never fall inside it. Remote hosts stay reachable for installs.
;; ---------------------------------------------------------------------------
;; Both denies come before every allow: a `remote unix-socket` deny placed after the loopback port allows was
;; observed to cancel some of them (macOS 27), so the order here is load-bearing.
(deny network-outbound (remote ip "localhost:*"))
;; Unix-domain sockets reach local daemons (tmux, docker, ssh-agent, Paseo terminal workers) that would run
;; commands outside the sandbox. Only DNS-SD and sockets the agent creates in its own temp or worktree are allowed.
(deny network-outbound (remote unix-socket))
(allow network-outbound
  (remote unix-socket (path-literal "/private/var/run/mDNSResponder"))
  (remote unix-socket (subpath (param "TMP_DIR")))
  (remote unix-socket (subpath (param "PASEO_WORKTREES"))))
(allow network-outbound (remote ip (string-append "localhost:" (param "BUS_PORT"))))
(allow network-outbound
  (remote ip "localhost:39001") (remote ip "localhost:39002") (remote ip "localhost:39003")
  (remote ip "localhost:39004") (remote ip "localhost:39005") (remote ip "localhost:39006")
  (remote ip "localhost:39007") (remote ip "localhost:39008") (remote ip "localhost:39009")
  (remote ip "localhost:39010"))

;; No TCP/UDP listening at all. Otherwise an agent could take the bus port while the plugin reloads (the plugin
;; falls back to another port when its old one is taken) and collect other agents' bus tokens, or take 6767 while
;; the daemon restarts and impersonate it to the Manager's UI. Port-specific `network-bind` allows are not usable:
;; on macOS 27 they are honoured for some port numbers and silently ignored for others. Test servers listen on
;; Unix sockets under $TMPDIR or the worktree instead.
(deny network-bind (local ip "*:*"))

;; ---------------------------------------------------------------------------
;; R4 — no escape through other processes.
;; ---------------------------------------------------------------------------
;; Apple Events (osascript → Terminal "do script", System Events keystrokes into the Paseo window).
(deny appleevent-send)
;; LaunchServices (`open`) starts applications outside the sandbox; the window server and pasteboard give GUI control.
(deny mach-lookup
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name-prefix "com.apple.lsd.")
  (global-name "com.apple.coreservices.appleevents")
  (global-name "com.apple.windowserver.active")
  (global-name-prefix "com.apple.pasteboard.")
  (global-name "com.apple.screencapture.interactive")
  (global-name-prefix "com.apple.accessibility."))
;; Signals and process inspection only within this sandbox: no killing or attaching to the daemon.
(deny signal)
(allow signal (target same-sandbox))
(deny process-info*)
(allow process-info* (target same-sandbox))
(deny mach-priv-task-port)
